generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  sessions         Session[]
  ownedRooms       Room[]           @relation("RoomOwner")
  memberships      RoomMember[]
  roomBans         RoomBan[]        @relation("BannedUser")
  roomBansIssued   RoomBan[]        @relation("BannedBy")
  adminRoles       RoomAdmin[]
  sentMessages     Message[]
  sentRequests     FriendRequest[]  @relation("RequesterUser")
  receivedRequests FriendRequest[]  @relation("RecipientUser")
  friendsA         Friendship[]     @relation("FriendA")
  friendsB         Friendship[]     @relation("FriendB")
  bansIssued       UserBan[]        @relation("UserBanIssuer")
  bansReceived     UserBan[]        @relation("UserBanned")
  roomInvitesSent  RoomInvitation[] @relation("InvitedBy")
  roomInvitesRecv  RoomInvitation[] @relation("InvitedUser")
  roomWatermarks   UserRoomWatermark[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RoomType {
  PUBLIC
  PRIVATE
  DIRECT
}

model Room {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  type        RoomType @default(PUBLIC)
  ownerId     String?
  createdAt   DateTime @default(now())

  owner       User?            @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members     RoomMember[]
  admins      RoomAdmin[]
  bans        RoomBan[]
  messages    Message[]
  invitations RoomInvitation[]
  roomSeq     RoomSeq?
  watermarks  UserRoomWatermark[]
}

model RoomMember {
  userId    String
  roomId    String
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}

model RoomAdmin {
  userId String
  roomId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}

model RoomBan {
  id         String   @id @default(uuid())
  userId     String
  roomId     String
  bannedById String
  createdAt  DateTime @default(now())

  user     User @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bannedBy User @relation("BannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model RoomInvitation {
  id          String   @id @default(uuid())
  roomId      String
  invitedById String
  userId      String
  createdAt   DateTime @default(now())

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  user      User @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model RoomSeq {
  roomId String @id
  seq    BigInt @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Message {
  id          String    @id @default(uuid())
  roomId      String
  authorId    String
  content     String    @db.VarChar(3072)
  seq         BigInt?
  replyToId   String?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     Message?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[]   @relation("MessageReplies")
  attachments Attachment[]

  @@index([roomId, seq])
}

model Attachment {
  id           String   @id @default(uuid())
  messageId    String
  filename     String
  originalName String
  mimeType     String
  size         Int
  comment      String   @default("")
  createdAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// One row per user+room — tracks the highest seq the user has seen.
// Never grows with message volume, safe for users who disappear for years.
model UserRoomWatermark {
  userId  String
  roomId  String
  lastSeq BigInt @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String
  recipientId String
  message     String              @default("")
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())

  requester User @relation("RequesterUser", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("RecipientUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

model UserBan {
  id         String   @id @default(uuid())
  issuerId   String
  bannedId   String
  createdAt  DateTime @default(now())

  issuer User @relation("UserBanIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  banned User @relation("UserBanned", fields: [bannedId], references: [id], onDelete: Cascade)

  @@unique([issuerId, bannedId])
}
